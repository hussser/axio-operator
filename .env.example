# Clé API Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Port du serveur (défaut: 3000)
PORT=3000

# Clé secrète pour les webhooks n8n
N8N_WEBHOOK_SECRET=ton-secret-ici

# Google Calendar (OAuth2) — rempli après connexion
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gmail
GMAIL_USER=ton@email.com

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=levco-verify-2024

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# N8N instance URL (si self-hosted)
N8N_BASE_URL=http://localhost:5678
